{
  "name": "DS Audio Dark Theme",
  "short_name": "Darko",
  "version": "1.1",
  "manifest_version": 3,
  "description": "DS Audio Dark Theme",
  "icons": {
    "64": "ds.png"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://192.168.0.103:880/*",
        "https://192.168.0.103:880/*",
        "*://*.solvill.is-by.us/*"
      ],
      "css": [
        "theme.css"
      ]
    }
  ]
}